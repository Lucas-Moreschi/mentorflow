# Database
DATABASE_URL="postgresql://mentorflow:mentorflow_secret@localhost:5433/mentorflow"

# Docker PostgreSQL (used in docker-compose.yml)
POSTGRES_USER=mentorflow
POSTGRES_PASSWORD=mentorflow_secret
POSTGRES_DB=mentorflow

# NextAuth.js v5
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini (free at aistudio.google.com/app/apikey)
GEMINI_API_KEY="sua-chave-aqui"

# App
NODE_ENV="development"
PORT=3000
